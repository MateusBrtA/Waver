[Unit]
Description=Waver Server (voz, vídeo e chat)
Documentation=file:///opt/pulsecord/deploy/README-SERVIDOR.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pulsecord
Group=pulsecord
WorkingDirectory=/opt/pulsecord/server
EnvironmentFile=/etc/pulsecord/pulsecord.env
ExecStart=__NODE__ /opt/pulsecord/server/index.js --data /var/lib/pulsecord
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
LimitNOFILE=65536
__CAPS__

# Proteções: o serviço só escreve na pasta de dados
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/pulsecord

[Install]
WantedBy=multi-user.target
