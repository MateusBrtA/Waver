[Unit]
Description=Waver Server (voz, vídeo e chat)
Documentation=file:///opt/pulsecord/deploy/README-SERVIDOR.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pulsecord
Group=pulsecord
WorkingDirectory=/opt/pulsecord/server
EnvironmentFile=/etc/pulsecord/pulsecord.env
# launch.js escolhe a versão (a instalada ou uma baixada pela atualização automática) e reinicia ao atualizar
ExecStart=__NODE__ /opt/pulsecord/server/launch.js --data /var/lib/pulsecord
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
# o supervisor (launch.js) recebe o SIGTERM e desliga o servidor com calma; o que sobrar leva SIGKILL no fim
KillMode=mixed
LimitNOFILE=65536
__CAPS__

# Proteções: o serviço só escreve na pasta de dados
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/pulsecord

[Install]
WantedBy=multi-user.target
