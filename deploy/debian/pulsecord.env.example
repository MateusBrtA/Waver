# Configuração do servidor Waver (lida pelo systemd e por Iniciar-Servidor no Windows).
# Depois de mudar: systemctl restart pulsecord

# Porta TCP (entrada). Libere-a no firewall em IPv4 e IPv6.
PORT=3000

# "::" escuta IPv6 e IPv4 ao mesmo tempo. Use "0.0.0.0" para só IPv4 ou um IPv6 específico.
PULSECORD_HOST=::

# Endereço que aparece para os amigos (ex.: https://chat.exemplo.com ou http://[2804:14c::1]:3000).
#PULSECORD_PUBLIC_URL=

# Código do dono (entra como Host). Se vazio, é gerado e salvo em /var/lib/pulsecord/owner-code.txt.
#PULSECORD_OWNER_CODE=

# Atrás de proxy HTTPS (Caddy/nginx) na mesma máquina: loopback
#PULSECORD_TRUST_PROXY=loopback

# TURN próprio (coturn com use-auth-secret). Preenchido pelo install.sh --with-turn.
#PULSECORD_TURN_URLS=turn:chat.exemplo.com:3478?transport=udp,turn:chat.exemplo.com:3478?transport=tcp
#PULSECORD_TURN_SECRET=
#PULSECORD_STUN_URLS=stun:chat.exemplo.com:3478

# SFU (mediasoup): nas chamadas grandes cada pessoa envia o áudio/vídeo UMA vez para o servidor,
# que repassa para os outros (sem SFU cada um envia uma cópia para cada pessoa e o upload satura).
#   auto  = a call passa para o SFU quando tiver mais de PULSECORD_SFU_MIN_PEERS pessoas (recomendado)
#   1     = todas as calls pelo SFU
#   0     = desligado (padrão): sempre malha P2P
# Se o mediasoup não estiver instalado ou não abrir as portas, as calls continuam em malha sozinhas.
#PULSECORD_SFU=auto
#PULSECORD_SFU_MIN_PEERS=4
# IPs que os clientes usam para chegar ao SFU (o servidor detecta sozinho se ficar vazio).
# Atrás de NAT (IPv4 de casa), ponha o IPv4 PÚBLICO e redirecione a faixa UDP no roteador;
# "off" desliga uma das famílias.
#PULSECORD_SFU_ANNOUNCED_IPV4=203.0.113.10
#PULSECORD_SFU_ANNOUNCED_IPV6=2804:14c:abcd::10
# Faixa de portas da mídia (UDP; TCP também, para redes que bloqueiam UDP). Libere no firewall.
# Cada pessoa usa ~4 portas: 1000 portas = ~250 pessoas ao mesmo tempo. Não use a faixa do TURN (49160-49200).
#PULSECORD_SFU_RTC_MIN_PORT=40000
#PULSECORD_SFU_RTC_MAX_PORT=40999
#PULSECORD_SFU_TCP=1
# Processos do mediasoup (1 por núcleo de CPU que quiser usar; 1 aguenta dezenas de pessoas)
#PULSECORD_SFU_WORKERS=1
# Limite de envio por pessoa ao SFU, em kbps (microfone + câmera + tela)
#PULSECORD_SFU_MAX_INCOMING_KBPS=30000

# Atualização automática pelo GitHub (padrão: ligada). Confere a cada PULSECORD_AUTO_UPDATE_HOURS horas,
# baixa só o que mudou e confere a assinatura oficial. Se só a interface mudou, troca na hora; se o servidor
# mudou, reinicia (~2 s) quando não houver ninguém em chamada. Depois de PULSECORD_AUTO_UPDATE_MAX_WAIT_H horas
# esperando a chamada esvaziar, reinicia entre 4h e 6h da manhã (0 = só reinicia com as chamadas vazias).
# Precisa de saída para a internet em IPv4: o GitHub não tem IPv6.
#PULSECORD_AUTO_UPDATE=0
#PULSECORD_AUTO_UPDATE_HOURS=6
#PULSECORD_AUTO_UPDATE_MAX_WAIT_H=24

# Anúncio na rede local (descoberta automática na LAN). Num servidor na internet, deixe desligado.
#PULSECORD_LAN_DISCOVERY=1

# "off" desliga o uso do Node como motor JavaScript do yt-dlp (YouTube).
#PULSECORD_YTDLP_JS_RUNTIME=off
