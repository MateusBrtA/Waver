# HTTPS automático (Let's Encrypt) na frente do Waver. IPv6 e IPv4 funcionam sozinhos
# se o domínio tiver registros AAAA e A apontando para esta máquina.
__DOMAIN__ {
	encode zstd gzip
	reverse_proxy 127.0.0.1:__PORT__ {
		# uploads grandes e WebSocket (socket.io) sem cortar
		flush_interval -1
		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
	request_body {
		max_size 2GB
	}
}
